# Sovereign Security .gitignore
# Strictly prevent secret exposure and build clutter

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
/secrets/
/private/
!src/secrets/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Outputs
dist/
build/
coverage/
*.tsbuildinfo
.scratch/
.aider-desk/

# Operating System
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

.env.local

.next/

out/

__pycache__/

.venv/

venv/

*.sqlite*

*.db

*.zip

*.webp

*.mp4
