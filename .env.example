# ==============================================================================
# Sovereign Security — Environment Configuration Template
# ==============================================================================
# Copy this template to .env for deployment or local execution.
# NEVER commit the real .env file or real secrets to version control.
# In production (e.g. Render), populate these via the platform Environment settings.
# ==============================================================================

# Node Runtime & Network
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Service Identity
SERVICE_NAME=sovereign-security
SERVICE_VERSION=2.0.0-phase2c

# ------------------------------------------------------------------------------
# Ingress Authentication & API Keys (Bearer / X-API-Key)
# ------------------------------------------------------------------------------
# Enforces HTTP ingress token checks on all /api/v1/* and /metrics endpoints.
# Defaults to true in production. Set to 'true' to explicitly enforce.
ENFORCE_INGRESS_AUTH=true

# Root Administrative API Key (Full administrative & containment-release privileges)
SOVEREIGN_ADMIN_API_KEY=

# Security Operations Key (Alert triage, baseline synchronization, standard operations)
SOVEREIGN_OPERATOR_API_KEY=

# Read-Only Audit & Observability Key (Audit log verification, telemetry ingestion)
SOVEREIGN_AUDIT_API_KEY=

# ------------------------------------------------------------------------------
# SOC Dashboard Protection & Access Controls
# ------------------------------------------------------------------------------
# If true, / and /dashboard routes require HTTP Basic Authentication challenge.
# Defaults to true in production.
PROTECT_DASHBOARD=true

# If true, completely disables / and /dashboard routes, returning HTTP 404.
DISABLE_DASHBOARD=false

# HTTP Basic Authentication credentials for SOC Dashboard UI
SOC_DASHBOARD_USER=
SOC_DASHBOARD_PASSWORD=

# ------------------------------------------------------------------------------
# Ecosystem Integration HMAC Secrets
# ------------------------------------------------------------------------------
# Cryptographic pre-shared keys for zero-trust ecosystem HMAC signatures.
# If an entity key is omitted, that integration safely fails closed (INVALID_API_KEY).
SOVEREIGN_OS_SECRET_KEY=
MTF_TELEMETRY_SECRET_KEY=
COMPLIANCE_LABS_SECRET_KEY=
AUDIOBLUE_BUILD_SECRET_KEY=
GRIDD_CORP_SECRET_KEY=

# ------------------------------------------------------------------------------
# Cryptographic Audit Ledger & Persistent Storage
# ------------------------------------------------------------------------------
# Mount path for the append-only cryptographic audit ledger.
# Production Render persistent disk must be mounted at /data.
AUDIT_STORAGE_PATH=/data/audit.log

# Bounded in-memory sliding window for audit ledger (O(1) memory startup)
AUDIT_MAX_MEMORY_RECORDS=500

# ------------------------------------------------------------------------------
# Application-Layer Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=300

# ------------------------------------------------------------------------------
# AI Security & Model Armor
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek/deepseek-r1
